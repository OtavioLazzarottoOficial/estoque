PORT=3333
DATABASE_URL="postgresql://postgres:docker@localhost:5432/estoque?schema=public"
JWT_PRIVATE_KEY="sua_chave_privada_em_base64"
JWT_PUBLIC_KEY="sua_chave_publica_em_base64"
CORS_ORIGINS="*"

# Armazenamento: "local" (pasta) ou "r2" (Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH="./uploads"
# Opcional no driver local: URL pública usada para montar a URL salva no banco
# STORAGE_PUBLIC_URL="https://api.seu-dominio.com"

# Cloudflare R2 (obrigatório quando STORAGE_DRIVER=r2)
# CLOUDFLARE_ACCOUNT_ID="seu_account_id"
# AWS_ACCESS_KEY_ID="sua_access_key_id_do_r2"
# AWS_SECRET_ACCESS_KEY="sua_secret_access_key_do_r2"
# AWS_BUCKET_NAME="nome-do-bucket"
# AWS_ENDPOINT="https://seu_account_id.r2.cloudflarestorage.com" # opcional
# AWS_REGION="auto"
# URL pública do bucket (r2.dev ou domínio customizado)
# CLOUDFLARE_R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"
